# Backend secrets. Never expose the service-role key to the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-project-key
SUPABASE_SECRET_KEY=sb_secret_your-server-key

GOOGLE_API_KEY=your-gemini-api-key        # https://aistudio.google.com/apikey
GROQ_API_KEY=your-groq-api-key            # https://console.groq.com/keys

# Optional (defaults shown)
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001
WHISPER_MODEL=whisper-large-v3-turbo
CHUNK_MINUTES=10
FRONTEND_ORIGINS=http://localhost:5173
# Hint that nudges Whisper toward your lecture language mix / script
WHISPER_HINT=University lecture. May mix English, Hindi and Gujarati; write everything in Roman script.
